# =============================================================================
# Brandbiz AI — environment variables template
# Copy this file to .env and fill in all required fields.
# Never commit .env to git — it is in .gitignore.
# =============================================================================

# --- Database ---
# Change these to match the values in docker-compose.yml (or your managed DB).
# For a fresh Brandbiz instance use "brandbiz" as DB name and user (see Step 4).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=brandbiz
POSTGRES_USER=brandbiz
# Any strong random password. On Linux: openssl rand -hex 32
POSTGRES_PASSWORD=

# --- Garage S3-compatible object storage ---
# Run these once after `docker compose up -d garage`:
#   docker compose exec garage garage key new brandbiz-key
#   docker compose exec garage garage bucket create brandbiz-files
#   docker compose exec garage garage bucket allow --read --write brandbiz-files --key <key-id>
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# --- Crypto ---
# AES-256-GCM key used to encrypt message content at rest.
# REQUIRED. Generate once and keep safe — rotating requires re-encrypting all rows.
#   openssl rand -base64 32
ENCRYPTION_KEY=
# Increment only when rotating; old versions must be kept for decryption of existing rows.
ENCRYPTION_KEY_VERSION=1

# --- Auth ---
# HS256 JWT signing secret. REQUIRED.
#   openssl rand -hex 32
JWT_SECRET=

# Google Workspace OAuth 2.0
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: https://api.<your-brandbiz-domain>/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Restrict sign-in to this Workspace domain (e.g. brandbiz.com). Leave blank for any Google account.
GOOGLE_WORKSPACE_DOMAIN=

# --- Cookie settings (production) ---
# COOKIE_DOMAIN=.brandbiz.ai          # leading dot required for subdomain sharing
# COOKIE_SECURE=true                  # set true when behind HTTPS (Caddy/nginx)

# --- CORS ---
# Comma-separated JSON list of allowed frontend origins.
# CORS_ORIGINS='["https://chat.brandbiz.ai"]'

# --- Local LLM (Ollama or llama.cpp — OpenAI-compatible /v1/* API) ---
# URL of the primary chat model server (defaults to llamacpp-primary service in docker-compose).
LLM_PRIMARY_URL=http://192.168.20.18:12341
# Exact model name as reported by `ollama list` on that server.
LLM_PRIMARY_MODEL=gemma4:26b

# --- Embedding server for RAG (BGE-M3 via Ollama) ---
# Set to the same host as LLM_PRIMARY_URL if bge-m3 is loaded there.
# Run `ollama pull bge-m3:latest` on the server once before starting the stack.
LLM_EMBED_URL=http://192.168.20.18:12341
LLM_EMBED_MODEL=bge-m3:latest

# How long Ollama keeps a model in VRAM after a request.
# "0" = release immediately (recommended when multiple models share one GPU).
# "-1" = keep forever. "5m" = keep 5 minutes.
LLM_KEEP_ALIVE=0

# --- RAG tuning (optional — defaults shown) ---
# RAG_TOP_K=5
# RAG_CHUNK_TOKENS=500
# RAG_CHUNK_OVERLAP=50
# RAG_MAX_DISTANCE=0.6

# --- External LLM APIs (leave blank to disable) ---
# Brandbiz-specific keys — do NOT copy keys from any other deployment.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=

# --- Hermes Agent (self-hosted, OpenAI-compatible API server) ---
# Runs as the `hermes` service in docker-compose.yml (official
# nousresearch/hermes-agent image — `docker compose up` installs and starts
# it automatically, no manual `hermes setup` needed). The hermes-init service
# writes its config.yaml/.env on first boot only, pointed at HERMES_OLLAMA_URL
# below; it never overwrites an existing config, so re-running `hermes-init`
# after the volume already exists is a no-op.
#
# REQUIRED. Any strong random token — this becomes both the value backend-api
# sends as a Bearer token AND Hermes's own API_SERVER_KEY (hermes-init writes
# it into Hermes's config using this same value, so they always match).
#   openssl rand -hex 32
# Leave blank to disable Hermes registration entirely.
HERMES_API_KEY=
# backend-api and hermes are both on the compose `internal` network, so the
# container name resolves directly — no host networking needed. Only change
# this if backend-api runs outside Docker (e.g. http://localhost:8642/v1).
HERMES_API_URL=http://hermes:8642/v1
# Read timeout (seconds) for a single Hermes call. Background tasks (Task 3.12) run
# Hermes's full tool loop unattended and can take much longer than interactive chat.
HERMES_API_TIMEOUT=600
# Which Ollama server + tool-calling-capable model Hermes itself uses to reason.
# Model must already be pulled on that Ollama host (`ollama pull <model>` or
# `POST /api/pull`) before Hermes can use it.
HERMES_OLLAMA_URL=http://192.168.20.18:12341/v1
HERMES_OLLAMA_MODEL=hermes3:8b

# --- n8n outbound webhook ---
# Single webhook URL for all Gateway→n8n events (LINE alert, label-inbox, etc.).
# Use the Production URL (.../webhook/...) for always-on delivery.
# Leave blank to disable all outbound triggers.
N8N_WEBHOOK_URL=

# --- Obsidian vault sync (read-only RAG ingestion) ---
# Shared team vault, read-only. Leave VAULT_GIT_URL blank to disable sync entirely.
# Embed the access token in the URL: https://<token>@github.com/org/vault-repo.git
# Never commit a real token here.
VAULT_GIT_URL=
VAULT_BRANCH=main
# Service-account user that owns every ingested vault file (mint it once via
# `python scripts/create_service_account.py --email obsidian-bot@service.local`).
VAULT_BOT_EMAIL=obsidian-bot@service.local
# Run the sync on a schedule (no Celery in demo mode) — host cron example:
#   0 * * * * docker compose exec -T backend-api python -m scripts.sync_vault >> /var/log/vault_sync.log 2>&1

# --- Docker Compose override (optional) ---
# COMPOSE_FILE=docker-compose.yml
